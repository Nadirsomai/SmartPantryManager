<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".SettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_navigation"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="-24dp"
            android:layout_marginTop="-28dp"
            android:layout_marginEnd="-24dp"
            android:background="@color/surface_black"
            android:contentDescription="@string/main_navigation_description"
            tools:menu="@menu/main_navigation_menu" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.16"
            android:text="@string/settings_wordmark"
            android:textColor="@color/gold"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityHeading="true"
            tools:targetApi="p"
            android:text="@string/settings_title"
            android:textColor="@color/warm_white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_intro"
            android:textColor="@color/muted_text"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:background="@color/gold_dark" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/surface_black"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/gold_dark"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_expiry_alerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/expiry_alerts"
                    android:textColor="@color/warm_white"
                    android:textSize="17sp"
                    app:buttonTint="@color/gold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/expiry_alerts_hint"
                    android:textColor="@color/muted_text"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/warning_period"
                    android:textColor="@color/gold_light"
                    android:textSize="14sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/surface_black_light"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/gold_dark"
                    app:strokeWidth="1dp">

                    <Spinner
                        android:id="@+id/spinner_expiry_warning_days"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:entries="@array/expiry_warning_day_labels"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp"
                        android:popupBackground="@color/surface_black_light"
                        android:spinnerMode="dropdown" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save_settings"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:text="@string/save_settings"
            android:textAllCaps="false"
            android:textColor="@color/app_black"
            android:textSize="16sp"
            app:backgroundTint="@color/gold"
            app:cornerRadius="8dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
